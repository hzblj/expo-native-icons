{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The package's TypeScript source, as Metro runs it (metro.config.js maps its `source` export), so the example
    // type-checks against the package without a build. kara's own imports of it land here too.
    "paths": {
      "@hzblj/expo-native-icons": ["../../packages/expo-native-icons/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "native-icons.d.ts"]
}
