{
  "name": "@hzblj/expo-native-icons",
  "version": "0.1.4",
  "description": "Your SVG icons as native assets for Expo: a config plugin that turns them into iOS asset catalog images and Android vector drawables, typed names, and a native view that draws them tinted.",
  "author": "Jan Blazej",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzblj/expo-native-icons.git",
    "directory": "packages/expo-native-icons"
  },
  "bugs": {
    "url": "https://github.com/hzblj/expo-native-icons/issues"
  },
  "homepage": "https://github.com/hzblj/expo-native-icons#readme",
  "keywords": [
    "android",
    "asset-catalog",
    "config-plugin",
    "expo",
    "expo-module",
    "icons",
    "ios",
    "react-native",
    "svg",
    "vector-drawable"
  ],
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "bin": {
    "native-icons": "./bin/native-icons.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./plugin": {
      "types": "./plugin/build/index.d.ts",
      "default": "./plugin/build/index.js"
    },
    "./cli": {
      "types": "./plugin/build/cli.d.ts",
      "default": "./plugin/build/cli.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./expo-module.config.json": "./expo-module.config.json",
    "./package.json": "./package.json"
  },
  "files": [
    "android/build.gradle",
    "android/src/main/**",
    "app.plugin.js",
    "bin",
    "build",
    "expo-module.config.json",
    "ios/*.podspec",
    "ios/*.swift",
    "plugin/build/**"
  ],
  "scripts": {
    "build": "rm -rf build plugin/build && tsc -p ./tsconfig.build.json && node ../../scripts/fallback-declarations.mjs && tsc -p ./plugin/tsconfig.json",
    "clean": "rm -rf build plugin/build",
    "prepack": "yarn run -T turbo run build --filter=$npm_package_name...",
    "lint": "yarn run -T concurrently \"yarn biome:check\" \"yarn tsc:check\"",
    "lint:fix": "yarn run -T biome check --write .",
    "biome:check": "yarn run -T biome check .",
    "tsc:check": "yarn run -T concurrently \"tsc -p ./tsconfig.ios.json\" \"tsc -p ./tsconfig.android.json\" \"tsc -p ./plugin/tsconfig.json --noEmit\"",
    "test": "node --import tsx --test plugin/test/*.test.ts"
  },
  "dependencies": {
    "svgpath": "^2.6.0"
  },
  "peerDependencies": {
    "expo": ">=57",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "~19.2.14",
    "expo": "~57.0.31",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
