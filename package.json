{
  "name": "@hzblj/expo-native-icons",
  "version": "0.1.0",
  "description": "Your SVG icons as native assets for Expo: a config plugin that turns them into iOS asset catalog images and Android vector drawables, typed names, and a native view that draws them tinted.",
  "author": "Jan Blazej",
  "license": "MIT",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "bin": {
    "native-icons": "./bin/native-icons.js"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./plugin": {
      "types": "./plugin/build/index.d.ts",
      "default": "./plugin/build/index.js"
    },
    "./cli": {
      "types": "./plugin/build/cli.d.ts",
      "default": "./plugin/build/cli.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./expo-module.config.json": "./expo-module.config.json",
    "./package.json": "./package.json"
  },
  "files": [
    "android/build.gradle",
    "android/src/**",
    "app.plugin.js",
    "bin",
    "build",
    "expo-module.config.json",
    "ios",
    "plugin/build/**"
  ],
  "keywords": [
    "android",
    "asset-catalog",
    "config-plugin",
    "expo",
    "expo-module",
    "icons",
    "ios",
    "react-native",
    "svg",
    "vector-drawable"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzblj/expo-native-icons.git"
  },
  "bugs": {
    "url": "https://github.com/hzblj/expo-native-icons/issues"
  },
  "homepage": "https://github.com/hzblj/expo-native-icons#readme",
  "scripts": {
    "build": "rm -rf build plugin/build && tsc -p tsconfig.build.json && tsc -p plugin/tsconfig.json",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepack": "yarn build",
    "release": "changeset publish",
    "test": "node --import tsx --test plugin/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "expo": ">=57",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@hzblj/biome-config": "^0.2.1",
    "@types/node": "^22.19.0",
    "@types/react": "~19.2.14",
    "expo": "~57.0.30",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "yarn@4.18.0"
}
